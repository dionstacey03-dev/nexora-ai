# Server-only Gemini API credential. Never expose this through a VITE_ variable.
GEMINI_API_KEY=

# Recommended for globally shared rate limits across Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional canonical public application URL.
APP_URL=

# Clerk authentication. The publishable key is safe for browser use; the secret key is server-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon PostgreSQL connection (not yet activated by the current app data layer).
DATABASE_URL=

# Optional isolated code-execution service. Never point this at the app's own server.
# Execution remains disabled until a dedicated sandbox adapter and provider are reviewed.
CODE_SANDBOX_URL=
CODE_SANDBOX_TOKEN=
